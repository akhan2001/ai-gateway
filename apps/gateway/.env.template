# --- required ---------------------------------------------------------------

DATABASE_URL=postgresql://tokenix:tokenix@localhost:5432/tokenix

# Fernet key protecting stored provider credentials. There is no default:
# generate one and keep it out of git.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Shared secret for the /admin provisioning endpoints. Leave empty to disable
# them entirely (any request is then rejected).
ADMIN_TOKEN=

# --- optional ---------------------------------------------------------------

# Upstash or any Redis URL. Without it, the key cache is in-process, which is
# correct but not shared across containers.
# REDIS_URL=rediss://default:...@...upstash.io:6379

ACPI_PRICES_PATH=/data/acpi_prices.json
ACPI_REFRESH_SECONDS=3600

KEY_CACHE_TTL_SECONDS=300
KEY_CACHE_MAX_ENTRIES=10000

WRITE_QUEUE_CAPACITY=8192
WRITE_BATCH_SIZE=256
WRITE_FLUSH_SECONDS=2.0

PROVIDER_TIMEOUT_SECONDS=120
PROVIDER_CONNECT_TIMEOUT_SECONDS=10

LOG_LEVEL=INFO
